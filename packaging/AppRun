#!/bin/sh
set -eu

APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export APPDIR
. "$APPDIR/usr/share/xlauncher/appimage-env.sh"
xlauncher_prepare_environment

case "${1-}" in
    --help|-h|--version|--doctor|--integrate|--unintegrate)
        ;;
    *)
        xlauncher_prepare_pixbuf_cache
        ;;
esac

if [ "$#" -eq 0 ]; then
    set -- --toggle
fi

exec "$APPDIR/usr/bin/xlauncher-toggle" "$@"
